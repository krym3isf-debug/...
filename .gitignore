# Dependencies
node_modules/

# Environment secrets — real credentials never get committed
.env
.env.local
.env.*.local

# Shopify CLI
.shopify/
*.theme-check-cache

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
blob-report/

# OS / editor
.DS_Store
.vscode/
.idea/

# Local Claude Code settings (machine-specific permission grants)
.claude/settings.local.json

# In-repo scratch space for staging files before pushing to external systems
# (e.g. Shopify theme JSON payloads) — never meant to persist, kept inside
# the repo boundary rather than an external /tmp scratchpad.
/.scratch/
