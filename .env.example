# Possessionless — environment variable shape only. Copy to .env and fill in real values.
# .env is git-ignored — never commit real credentials.
#
# NOTE: Shopify, Triple Whale, Klaviyo, and Windsor.ai (Meta Ads read/write) are already
# connected in this Claude environment via MCP connectors — you do NOT need to fill in
# credentials for those here just to let Claude use them. The variables below are only
# needed if/when you build custom scripts (outside Claude/MCP) that call these APIs directly.

# --- Meta / Facebook Marketing API (only needed for custom scripts, not for Claude's MCP access) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Active pixel only. Do not point this at the DONT USE pixels documented in
# .claude/skills/possessionless-brand/knowledge/tracking.md
META_PIXEL_ID=2236610750526527

# --- GA4 (only needed for server-side/Measurement Protocol calls) ---
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- Shopify (only needed for custom scripts outside the Shopify MCP connector) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# --- Triple Whale (only needed for custom scripts outside the Triple Whale MCP connector) ---
TRIPLE_WHALE_API_KEY=
